import streamlit as st
import google.generativeai as genai
import streamlit as st
st.sidebar.header("🔑 Keys टाका")
st.sidebar.text_input("Gemini API Key")
st.sidebar.text_input("Jira Email")
st.sidebar.text_input("Jira API Token", type="password")
st.sidebar.text_input("Jira Domain")
st.write("जर 4 Box दिसले तर OK आहे - मग मी Real Code देतो!")
st.set_page_config(page_title="Jira AI Agent by Sameer")
st.title("🤖 Jira Defect Auto-Analyzer Agent")
st.write("Chhatrapati Sambhajinagar | Sameer - QA + Agentic AI")



api_key = st.sidebar.text_input("", type="password")



st.subheader("Jira Bug Details टाका")
jira_id = st.text_input("Jira ID:", "BUG-101")
bug_title = st.text_area("Bug Title / Summary:", "Login button not working on checkout page after payment")
bug_desc = st.text_area("Bug Description / Steps to Reproduce:",
                        "Steps:\n1. Login with valid user\n2. Add item to cart\n3. Go to checkout\n4. Click Pay\n5. After payment, Login button disabled\n\nExpected: Should redirect to Order Success page\nActual: Button disabled, user stuck",
                        height=200)

logs = st.text_area("Error Logs (Optional):", "TypeError: Cannot read property 'token' of undefined at checkout.js:45")

if st.button("🔍 Analyze with AI Agent"):
    if not api_key:
        st.error("Sidebar मध्ये API Key टाका भैया जी!")
    else:
        try:
            genai.configure(api_key="")
            model = genai.GenerativeModel("gemini-3.5-flash")

            prompt = f"""
            You are a Senior QA & Developer Agent. Analyze this Jira Defect:

            Jira ID: {jira_id}
            Title: {bug_title}
            Description: {bug_desc}
            Logs: {logs}

            Give output in this EXACT format:

            *1. Root Cause Analysis:*
            *2. Defect Category:* (UI/Backend/API/Database/Integration)
            *3. Severity & Priority:* 
            *4. Suggested Fix for Developer:*
            *5. Test Cases to Re-verify:*

            Keep it short, professional and actionable for a developer.
            """
            with st.spinner("Agent Analysis करत आहे..."):
                res = model.generate_content(prompt)
                st.success("Analysis Complete!")
                st.markdown(res.text)

                # Download Button
                st.download_button("📥 Download Analysis Report", data=res.text, file_name=f"{jira_id}_Analysis.txt")
        except Exception as e:
            st.error(f"Error: {e}")

st.markdown("---")
st.info(
)
